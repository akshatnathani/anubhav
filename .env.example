# Copy to .env and fill in:  cp .env.example .env

APP_NAME=Anubhav's Tracker
TIMEZONE=Asia/Kolkata
CURRENCY=₹

# Public URL of the site. Used in the email links, so it must work from outside (his phone).
BASE_URL=https://tracker.example.com
PORT=8000

# Your admin login (created on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=you@gmail.com

# Your brother: created on first start with "DSA practice" (2/day, reminder 20:00) and
# "Money log" (reminder 21:30). Nothing is emailed until you click "Email login details" in the admin page.
MEMBER_NAME=Anubhav
MEMBER_USERNAME=anubhav
MEMBER_EMAIL=brother@gmail.com

# Supabase: Project > Connect (top bar) > "Session pooler" connection string (works over IPv4).
# Replace [YOUR-PASSWORD] with the database password. Special characters in it must be URL-encoded.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Long random strings:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Google Apps Script web app URL (Deploy > New deployment > Web app). Sends the emails. Keep it private.
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# Only if you use the optional Cloudflare tunnel profile
CLOUDFLARE_TUNNEL_TOKEN=
