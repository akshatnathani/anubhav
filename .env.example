# Local only — never committed. Used by the setup commands
#   uv run python src/app.py init-db
#   uv run python src/app.py set-password USERNAME
# and as the source of the Worker secrets (see README).

# Supabase > Connect > Session pooler
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=you@gmail.com

# First member, created by init-db with "DSA practice" and "Money log". Nothing is emailed until you
# click "Email login details" on the admin page.
MEMBER_NAME=Anubhav
MEMBER_USERNAME=anubhav
MEMBER_EMAIL=brother@gmail.com

# Worker secrets:  npx wrangler secret put SECRET_KEY  /  npx wrangler secret put APPS_SCRIPT_URL
SECRET_KEY=
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
