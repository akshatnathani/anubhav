{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anubhav-tracker",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["python_workers"],

  // Non-secret settings. Secrets (SECRET_KEY, APPS_SCRIPT_URL) are set with `wrangler secret put`.
  "vars": {
    "APP_NAME": "Anubhav's Tracker",
    "TIMEZONE": "Asia/Kolkata",
    "CURRENCY": "₹",
    "BASE_URL": "https://anubhav-tracker.anubhav-tracker.workers.dev"
  },

  // Supabase through Hyperdrive. Create with caching disabled (see README), then paste the id here.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "70a77b542fb84771acc6c3f95ba26623",
      "localConnectionString": "postgresql://postgres:pw@localhost:5433/postgres"
    }
  ],

  // Check for due reminders and send queued emails every minute.
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true }
}
